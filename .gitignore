# Stale mirror copies: compose.js writes only apps/landing-page/index.html.
# Never re-commit a second copy of the brief or the design doc.
apps/landing-page/inputs.json
apps/landing-page/DESIGN.md

# graphify machine-local state: these embed absolute paths (C:\Users\<name>\...)
# and caches. The graph outputs themselves (graph.json, GRAPH_REPORT.md, graph.html,
# manifest.json, cost.json, .graphify_labels.json) stay tracked.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/

